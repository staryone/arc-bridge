NEXT_PUBLIC_NETWORK=testnet
NEXT_PUBLIC_APP_NAME=Arc Bridge
# Tier fees (bps of transfer amount, on top). Industry CCTP UIs often 10–25 bps.
NEXT_PUBLIC_FEE_BPS_STANDARD=15
NEXT_PUBLIC_FEE_BPS_FAST=25
NEXT_PUBLIC_FEE_BPS_EXTREME=40
NEXT_PUBLIC_MAX_FEE_BPS=100
NEXT_PUBLIC_FEE_RECIPIENT=0xe85dCc8c424089c03F46DC7177B93689613132b7
# Optional: USDC human-units maxFee headroom for Extreme (else App Kit estimates)
# NEXT_PUBLIC_EXTREME_MAX_FEE=2
# REQUIRED for WalletConnect QR / mobile (https://cloud.walletconnect.com) — not for MetaMask inject
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
